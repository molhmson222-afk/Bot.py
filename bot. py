        return

    user = update.effective_user
    client = get_registered_client(user.id)

    status_line = (
        f"✅ *حسابك مسجل:* {client['name']} ({client['residence']})\nأرسل صورة شارت الذهب (5m) أو وصفاً نصياً للتحليل."
