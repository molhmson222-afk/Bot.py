import logging
import os
from google import genai
from google.genai import types
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes, MessageHandler, filters

logging.basicConfig(level=logging.INFO)

TELEGRAM_TOKEN = os.environ["TELEGRAM_BOT_TOKEN"]
GEMINI_API_KEY = os.environ["GEMINI_API_KEY"]

gemini_client = genai.Client(api_key=GEMINI_API_KEY)

SYSTEM_PROMPT = """
أنت محلل فني خبير في مفاهيم المال الذكي (ICT) واستراتيجية AMD (التجميع، التلاعب، التوزيع)
مع الفجوات السعرية العادلة (Fair Value Gap - FVG).
عند استلام صورة شارت أو رسم بياني:
1. حدد حالة السوق (تجميع، تلاعب/سحب سيولة، أو توزيع/اتجاه).
2. حدد مناطق FVG إن وُجدت بوضوح.
3. أعطِ رؤية منظمة تشمل: نقطة الدخول المقترحة (Entry)، وقف الخسارة (SL)، والأهداف (TP1 / TP2) مع التذكير بأن هذا تحليل فني وليس توصية استثمارية ملزمة.
"""


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    await update.message.reply_text(
        "أهلاً بك! أرسل صورة الشارت (خصوصاً فريم 5 دقائق للذهب أو العملات) وسأقوم بتحليلها وفق AMD + FVG."
    )


async def handle_photo(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    if not update.message or not update.message.photo:
        return

    status_msg = await update.message.reply_text("⏳ جاري تحليل الصورة...")

    try:
        # أعلى دقة للصورة المرسلة
        photo = update.message.photo[-1]
        tg_file = await photo.get_file()
        image_bytes = bytes(await tg_file.download_as_bytearray())

        caption = update.message.caption or "حلل هذه الصورة بدقة وفق استراتيجية AMD و FVG وحدد Entry و SL و TP."

        response = gemini_client.models.generate_content(
            model="gemini-2.5-flash",
            contents=[
                types.Part.from_bytes(data=image_bytes, mime_type="image/jpeg"),
                f"{SYSTEM_PROMPT}\n\nالمطلوب: {caption}",
            ],
        )

        reply_text = response.text or "لم أتمكن من استخراج تحليل واضح من الصورة."
        await status_msg.edit_text(reply_text[:4000])
    except Exception as exc:
        logging.exception("Error analyzing image")
        await status_msg.edit_text(f"❌ حدث خطأ أثناء التحليل: {exc}")


def main() -> None:
    app = ApplicationBuilder().token(TELEGRAM_TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.PHOTO, handle_photo))
    app.run_polling(drop_pending_updates=True)


if __name__ == "__main__":
    main()
